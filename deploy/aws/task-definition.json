{
  "family": "makerspace",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::695694683627:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "makerspace",
      "image": "695694683627.dkr.ecr.eu-west-1.amazonaws.com/uni/makerspace:latest",
      "portMappings": [
        { "containerPort": 8080, "hostPort": 8080, "protocol": "tcp" }
      ]
    }
  ]
}
