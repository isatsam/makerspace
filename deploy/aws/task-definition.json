{
  "family": "makerspace",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::695694683627:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "makerspacehub",
      "image": "695694683627.dkr.ecr.eu-west-1.amazonaws.com/uni/makerspace:latest",
      "portMappings": [
        { "containerPort": 5000, "hostPort": 5000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "FLASK_ENV", "value": "production" },
        { "name": "PORT", "value": "5000" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/makerspace",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "makerspace"
        }
      }
    }
  ]
}
