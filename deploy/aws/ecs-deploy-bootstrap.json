{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCreateEcsExecutionRole",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:iam::695694683627:role/ecsTaskExecutionRole"
    },
    {
      "Sid": "AllowAttachOnlyExecutionPolicy",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::695694683627:role/ecsTaskExecutionRole",
      "Condition": {
        "ArnEquals": {
          "aws:PolicyArn": "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
        }
      }
    },
    {
      "Sid": "AllowPassExecutionRoleToEcs",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::695694683627:role/ecsTaskExecutionRole",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" }
      }
    }
  ]
}
